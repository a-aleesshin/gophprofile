# Публичная точка входа: nginx слушает PUBLIC_PORT и проксирует /upload/ и /s3/
PUBLIC_PORT=8000
PUBLIC_BASE=http://localhost:8000

# Секрет подписи ссылок, минимум 32 байта. Без него compose не стартует.
# Сгенерировать: openssl rand -hex 32
LINK_SECRET=

# Заполняется только на время ротации секрета
LINK_PREVIOUS_SECRET=

# Общий секрет межсервисной авторизации gRPC, минимум 32 байта.
# Тот же токен должен быть у profile. Сгенерировать: openssl rand -hex 32
GRPC_TOKEN=

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# pprof выключен, пока не задан адрес. Для отладки:
# PPROF_ADDR=127.0.0.1:6060 — только внутри контейнера, доступ через docker exec.
PPROF_ADDR=

# Подписанные токены личности у profile. IDENTITY_SECRET подписывает токены и
# наружу не уходит.
#
# IDENTITY_DEMO_LOGIN открывает демо-вход: POST /api/v1/sessions выдаёт токен
# на любой user_id по общему секрету. Это дверь для демонстрации, а не логин:
# секрет вводится в браузере, значит любой, кто открыл страницу, может говорить
# от чужого имени. Поэтому по умолчанию дверь закрыта и маршрут не регистрируется
# вовсе. При закрытой двери IDENTITY_LOGIN_SECRET должен быть пустым — иначе
# сервис не стартует, чтобы секрет не выглядел работающим, когда он не работает.
IDENTITY_SECRET=
IDENTITY_DEMO_LOGIN=true
IDENTITY_LOGIN_SECRET=
IDENTITY_PREVIOUS_SECRET=

# Ретенция outbox. Опубликованные строки — рутина, их можно чистить быстро;
# припаркованные это инциденты с last_error, которые кто-то должен прочитать,
# поэтому у них своё, длинное окно.
PRUNE_OUTBOX_RETENTION=72h
PRUNE_OUTBOX_PARKED_RETENTION=720h

# Сколько раз консьюмер пробует применить сообщение, прежде чем сдаться:
# Drop, то есть коммит оффсета в Kafka и dead-letter в Rabbit. Без предела
# одно сообщение, которое обработчик не может применить, крутит свою
# партицию вечно. Отброшенные строки живут дольше обработанных — это инцидент.
CONSUME_MAX_ATTEMPTS=10
PRUNE_INBOX_DROPPED_RETENTION=720h

# Сколько раз реконсайлер пробует спасти просроченный тикет, прежде чем
# признать его безнадежным: aborted плюс удаление staging-объекта.
# Без предела одна отравленная строка стоит в голове очереди вечно.
JOBS_RECONCILE_ATTEMPTS=10

# Лимиты загрузки у profile; у всех есть значения по умолчанию.
POLICY_MAX_SIZE_BYTES=10485760
POLICY_ALLOWED_MIME=image/jpeg,image/png,image/webp
POLICY_MAX_AVATARS_PER_USER=20

LOG_LEVEL=info
LOG_FORMAT=json
