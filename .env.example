# Публичная точка входа: nginx слушает PUBLIC_PORT и проксирует /upload/ и /s3/
PUBLIC_PORT=8000
PUBLIC_BASE=http://localhost:8000

# Секрет подписи ссылок, минимум 32 байта. Без него compose не стартует.
# Сгенерировать: openssl rand -hex 32
LINK_SECRET=

# Заполняется только на время ротации секрета, см. docs/namespaces.md 3.1
LINK_PREVIOUS_SECRET=

# Общий секрет межсервисной авторизации gRPC, минимум 32 байта.
# Тот же токен должен быть у profile. Сгенерировать: openssl rand -hex 32
GRPC_TOKEN=

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# pprof выключен, пока не задан адрес. Для отладки:
# PPROF_ADDR=127.0.0.1:6060 — только внутри контейнера, доступ через docker exec.
PPROF_ADDR=

# Лимиты загрузки у profile; у всех есть значения по умолчанию.
POLICY_MAX_SIZE_BYTES=10485760
POLICY_ALLOWED_MIME=image/jpeg,image/png,image/webp
POLICY_MAX_AVATARS_PER_USER=20

LOG_LEVEL=info
LOG_FORMAT=json
