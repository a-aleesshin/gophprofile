# Публичная точка входа: nginx слушает PUBLIC_PORT и проксирует /upload/ и /s3/
PUBLIC_PORT=8000
PUBLIC_BASE=http://localhost:8000

# Секрет подписи ссылок, минимум 32 байта. Без него compose не стартует.
# Сгенерировать: openssl rand -hex 32
LINK_SECRET=

# Заполняется только на время ротации секрета, см. docs/namespaces.md 3.1
LINK_PREVIOUS_SECRET=

# Общий секрет межсервисной авторизации gRPC, минимум 32 байта.
# Тот же токен должен быть у profile. Сгенерировать: openssl rand -hex 32
GRPC_TOKEN=

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

LOG_LEVEL=info
LOG_FORMAT=json
