# Значения для локального кластера. Файл с реальными значениями
# (values-local.yaml) в репозиторий не попадает, его создаёт `task env`.
#
# Строки подключения и ключи хранилища ниже — учётные данные стенда, те же,
# что в .env.example. Для любого другого кластера подставьте свои.

image:
  pullPolicy: IfNotPresent

services:
  file:
    env:
      S3_PUBLIC_BASE: http://localhost:8080/s3
      LINK_PUBLIC_BASE: http://localhost:8080
      TRACING_ENABLED: "true"
      TRACING_ENDPOINT: jaeger.monitoring:4317
    secretEnv:
      POSTGRES_DSN: postgres://USER:PASSWORD@file-db:5432/file?sslmode=disable
      S3_ACCESS_KEY: ACCESS_KEY
      S3_SECRET_KEY: SECRET_KEY
      RABBIT_URL: amqp://USER:PASSWORD@rabbitmq:5672/
  profile:
    env:
      CONTENT_PUBLIC_BASE: http://localhost:8080
      CONTENT_PLACEHOLDER: http://localhost:8080/static/placeholder.svg
      IDENTITY_DEMO_LOGIN: "true"
      TRACING_ENABLED: "true"
      TRACING_ENDPOINT: jaeger.monitoring:4317
    secretEnv:
      POSTGRES_DSN: postgres://USER:PASSWORD@profile-db:5432/profile?sslmode=disable

workloads:
  file-server:
    autoscaling:
      enabled: true
      minReplicas: 1
      maxReplicas: 4
      targetCPUUtilizationPercentage: 70
      scaleDownStabilizationSeconds: 60
  profile-server:
    autoscaling:
      enabled: true
      minReplicas: 1
      maxReplicas: 4
      targetCPUUtilizationPercentage: 70
      scaleDownStabilizationSeconds: 60

networkPolicy:
  tracing:
    enabled: true
